    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "bool a = A < B;\r\n\r\nif (a) {\r\nbool c=C<A;\r\nY=B;\r\nX=c?A:C;\r\n}\r\n\r\nelse {\r\nbool b=C>B;\r\nX=A;\r\nY=b?C:B;\r\n}"
}

